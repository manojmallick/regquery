# RegQuery — environment template. Copy to .env and fill in. NEVER commit .env.

# --- Google Cloud / Gemini 3 (REQUIRED by hackathon rules) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=europe-west1
# Vertex AI is the default path on Google Cloud:
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3
EMBEDDING_MODEL=text-embedding-004

# --- MongoDB Atlas (partner) ---
ATLAS_CONNECTION_STRING=mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net
ATLAS_DB=regquery
ATLAS_COLLECTION=regulations
ATLAS_VECTOR_INDEX=regulatory_vector_index

# --- App ---
PORT=8080
NODE_ENV=development

# --- Calibrated abstention: below this top-hit similarity, RegQuery refuses to
# answer and escalates to a human instead of guessing. Raise for stricter, lower
# for chattier. (0.0–1.0) ---
ABSTAIN_THRESHOLD=0.6

# --- Demo mode: set MOCK=true to run the full UI + ApprovalBar flow with
# canned data and NO credentials (great for rehearsing the ~3-min demo). ---
# MOCK=true
